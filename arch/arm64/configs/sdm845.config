# =============================================================================
# SDM845 config fragment - sdm845-mainline / postmarketOS
#
#     make ARCH=arm64 defconfig sdm845.config
#
# Purpose, quoted from the commit message this file was born with
# ("arm64: configs: add sdm845 config fragment", Caleb Connolly / Joel Selvaraj):
#
#   "This config fragment produces the .config used by postmarketOS and other
#    distros, it is designed to be fairly minimal and specific to the supported
#    SDM845 devices whilst offering all the features you would expect (e.g.
#    nftables).  It disables other arm64 architectures to speed up build times
#    and decrease the size of the kernel image."
#
# Every line below therefore answers one of five questions:
#
#   hardware   a device-tree node in this tree has nothing to bind to without
#              it (the compatible string is quoted in the comment)
#   userspace  "pmbootstrap kconfig check" (pmaports kconfig_check_*.toml)
#              fails without it, or a pmOS component (iwd, Waydroid, wireguard,
#              containers, zram) needs it
#   phone UX   features users expect on a phone but defconfig does not provide
#   build size =n on everything the 18 supported boards cannot use
#   bring-up   debugging aids kept on deliberately (ftrace, pstore, ath10k)
#
# The comments cite the sdm845-mainline commit that introduced the option
# (date + subject) and, where one exists, the upstream/pmOS discussion.
#
# "DEAD:" marks a line whose Kconfig symbol no longer exists in this tree
# (v7.2-rc5).  kconfig ignores those silently, so they neither help nor hurt -
# but they also no longer do what the line says.  Verified by grepping every
# "config <SYM>" in the tree.
#
# Devices covered: OnePlus 6/6T, Pocophone F1, Samsung S9, SHIFT6mq, Pixel 3,
# Mi Mix 2S/3, Xiaomi Perseus, Sony Xperia XZ2/XZ3 (tama), LG G7 ThinQ,
# Lenovo Yoga C630 (sdm850), db845c.
# =============================================================================
# custom sdm845-next logo
# arm64 defconfig already sets CONFIG_LOGO=y (and FB), so only the variant and
# the file are overridden: a phone-holding Tux carried in this branch as
# drivers/video/logo/logo_linux_phone_clut224.ppm (58 KiB).
# ["hack! sdm845.config: Enable phone tux logo"]
CONFIG_LOGO_LINUX_CLUT224=y
CONFIG_LOGO_LINUX_CLUT224_FILE="drivers/video/logo/logo_linux_phone_clut224.ppm"

# Qualcomm Snapdragon 845 (SDM845) config fragment
# uname -r suffix, so a fragment build is not mistaken for a plain defconfig
# build (pmOS ships both). [2021-01-07 "arm64/configs: add op6 defconfig and
# fragments" - the commit that also documents the "make defconfig sdm845.config
# oneplus6.config" workflow]
CONFIG_LOCALVERSION="-sdm845"

# Needed for multiple devices
# GPIO_SHARED_PROXY (upstream v6.19): reference-counted ("voted") sharing of a
# single GPIO line between several consumers; gpiolib spawns it as an auxiliary
# device.  ARCH_QCOM selects HAVE_SHARED_GPIOS, so GPIO_SHARED=y here; the
# symbol's own default is m, =y keeps it off the deferred-probe path.  Enabled
# ahead of the device trees that need it - no sdm845 DT in this tree requests a
# shared line yet. [2025-11 fragment update]
CONFIG_GPIO_SHARED_PROXY=y
# Fuel gauge = battery percentage on every pmi8998 phone ("qcom,pmi8998-fg" in
# pmi8998.dtsi).  Still out-of-tree, carried as a patch on this branch.
# [2021-02-03 "sdm845.config: add pmi8998_fg"]
CONFIG_BATTERY_PMI8998_FG=m

# ---------------------------------------------------------------------------
# Per-device drivers.  Each block lists the DT node that makes the option
# necessary; panels are =y because DRM_MSM is =y and the splash has to come up
# before the rootfs is mounted, everything else is =m.
# ---------------------------------------------------------------------------
# OnePlus 6
# DT: sdm845-oneplus-enchilada.dts + sdm845-oneplus-common.dtsi
#   SOFEF00      panel@0 "samsung,sofef00"
#   BQ27XXX      "ti,bq27411" fuel gauge (OP6 uses a TI gauge, not pmi8998-fg)
#   HID_RMI +    "syna,rmi4-i2c" digitizer; RMI4_F55 is the sensor-tuning
#   RMI4_*       function that this panel/digitizer combination needs
CONFIG_DRM_PANEL_SAMSUNG_SOFEF00=y
CONFIG_BATTERY_BQ27XXX=m
CONFIG_HID_RMI=m
CONFIG_RMI4_CORE=m
CONFIG_RMI4_I2C=m
CONFIG_RMI4_F55=y
CONFIG_VIDEO_IMX371=m
CONFIG_VIDEO_IMX376=m
CONFIG_VIDEO_IMX519=m
CONFIG_VIDEO_LC89821X=m
CONFIG_VIDEO_S5K2X7SP=m
CONFIG_VIDEO_S5K3P9SP=m

# OnePlus 6T
# DT: sdm845-oneplus-fajita.dts - "samsung,s6e3fc2x01" panel
# [2022-10-13 "fixup: sdm845.config: enable 6T panel driver"] and the NXP/Goodix
# TFA98xx smart amp (also SHIFT6mq) [2022-07-14 "sdm845.config: enable tfa98xx
# codec"].  TFA98XX is the TFA1/TFA2 driver; TFA989X further down is the
# separate upstream driver for the TFA9895-class parts.
CONFIG_DRM_PANEL_SAMSUNG_S6E3FC2X01=y
CONFIG_SND_SOC_TFA98XX=m

# Pocophone F1
# DT: sdm845-xiaomi-beryllium-{tianma,ebbg}.dts - two panel variants shipped in
# the same phone, so both panel drivers are built in:
#   NOVATEK_NT36672A   "novatek,nt36672a"     (tianma)
#   EBBG_FT8719        "ebbg,ft8719"          (ebbg)
#   NOVATEK_NVT_TS     "novatek,nt36672a-ts"  touch on the tianma variant
#   (the ebbg variant's "focaltech,ft8719" touch is EDT_FT5X06, see below)
#   QCOM_GPI_DMA       gpi-dma@800000 in sdm845.dtsi - GENI QUP DMA, needed for
#                      the SPI/I2C peripherals on this board
#   TAS2559            TI smart amp
#   IMX363             rear sensor [2021-06-08 "media: imx363: introduce"]
CONFIG_DRM_PANEL_NOVATEK_NT36672A=y
CONFIG_DRM_PANEL_EBBG_FT8719=y
CONFIG_TOUCHSCREEN_NOVATEK_NVT_TS=m
CONFIG_QCOM_GPI_DMA=m
CONFIG_SND_SOC_TAS2559=m
CONFIG_VIDEO_IMX363=m

# Samsung S9 SM-G9600(starqltechn)
# DT: sdm845-samsung-starqltechn.dts.  Samsung wired a second PMIC stack next
# to the Qualcomm one, which is why so many Maxim/Samsung MFDs appear here:
#   S6E3HA8       "samsung,s6e3ha8" panel
#   S6SY761       "samsung,s6sy761" touchscreen
#   MFD_SEC_CORE  Samsung PMIC core, parent of...
#   S2DOS05       "samsung,s2dos05" display/touch power regulator
#   MAX77705 MFD  + its LED / charger sub-drivers
#   MAX17042      Maxim fuel gauge, MAX77693_HAPTIC the vibrator - no node in
#                 this tree yet, they come with the downstream S9 DT
#   PWM_CLK       PWM-from-a-clock shim used to drive the S9 haptic motor
CONFIG_DRM_PANEL_SAMSUNG_S6E3HA8=y
CONFIG_TOUCHSCREEN_S6SY761=m
CONFIG_MFD_SEC_CORE=m
CONFIG_REGULATOR_S2DOS05=m
CONFIG_MFD_MAX77705=m
CONFIG_LEDS_MAX77705=m
CONFIG_CHARGER_P9221=m
CONFIG_CHARGER_MAX77705=m
CONFIG_BATTERY_MAX17042=m
CONFIG_INPUT_MAX77693_HAPTIC=m
CONFIG_INPUT_CS40L20=m
CONFIG_PWM_CLK=m

# SHIFT6mq
# DT: sdm845-shift-axolotl.dts - "visionox,rm69299" panel (=m: this device boots
# fine without an early splash) [2021-12-20 "sdm845.config: enable rm69299 panel
# for SHIFT6mq"] and the upstream TFA989x amp [+ "Add TFA989X module for
# SHIFT6mq"].  Its touchscreen ("focaltech,ft5452") and lens actuator (dw9714)
# are in the shared blocks further down.
CONFIG_DRM_PANEL_VISIONOX_RM69299=m
CONFIG_SND_SOC_TFA989X=m

# Pixel 3
# DT: sdm845-google-blueline.dts / -google-common.dtsi (also crosshatch)
#   LG_SW43408    "lg,sw43408" panel
#   STMFTS        "st,stmfts" touchscreen (also Mi Mix 2S/3)
#   CS35L36       Cirrus speaker amp, "cirrus,cs35l36" - "Used in Google
#                 Pixel 3" [2024-08-27]
#   IMX355        front sensor; the 256 MB CMA setting further down exists
#                 because of exactly this sensor (see the libcamera block)
#   EEPROM_AT24   camera calibration EEPROM on the module
CONFIG_DRM_PANEL_LG_SW43408=y
CONFIG_TOUCHSCREEN_STMFTS=m
CONFIG_SND_SOC_CS35L36=m
CONFIG_VIDEO_IMX355=m
CONFIG_EEPROM_AT24=m

# Mi Mix 3
# DT: sdm845-xiaomi-perseus.dts [2025-06-22 "enable xiaomi perseus related
# configs"].  TAS2557 is live and is the amp on
# both perseus and dipper.
CONFIG_SND_SOC_TAS2557=m

# C630
# Lenovo Yoga C630 - an sdm850 (binned sdm845) laptop, DT:
# sdm850-lenovo-yoga-c630.dts.  Laptop-shaped needs that no phone has:
#   TI_SN65DSI86       "ti,sn65dsi86" DSI-to-eDP bridge (also Huawei Matebook E)
#   DRM_PANEL_EDP      "boe,nv133fhm-n61" via the generic eDP panel driver
#   PHY_QCOM_EDP       the SoC-side eDP PHY
#   I2C_HID_OF_ELAN    "hid-over-i2c" keyboard/touchpad
#   BACKLIGHT_PWM      "pwm-backlight" node
#   EC_LENOVO_YOGA_C630 "lenovo,yoga-c630-ec" embedded controller, and its
#   BATTERY_...C630     battery driver - upstream since v6.11, this fragment
#                       switched from the out-of-tree one in 2025-06
#                       ["replace with upstream yoga c630 battery driver"]
# [2022-11-25 "sdm845.config: add support for Yoga C630"]
CONFIG_DRM_TI_SN65DSI86=y
CONFIG_DRM_PANEL_EDP=y
CONFIG_PHY_QCOM_EDP=y
CONFIG_I2C_HID_OF_ELAN=m
CONFIG_BACKLIGHT_PWM=y
CONFIG_EC_LENOVO_YOGA_C630=m
CONFIG_BATTERY_LENOVO_YOGA_C630=m

# LG G7 ThinQ
# DT: sdm845-lg-judyln.dts / sdm845-lg-common.dtsi [2026-04 "sdm845.config: add
# LG G7 ThinQ drivers" + "Drivers for LG G7 ThinQ"]
#   SW49410              "lg,sw49410-lh609qh1" panel
#   TOUCHSCREEN_SW49410  "siw,sw49410_ts_spi", out-of-tree, on spi5 - which is
#   SPI_QCOM_GENI        why the GENI SPI controller is needed (it is the only
#                        board here with an SPI-attached touchscreen)
#   QCOM_WDT             "qcom,apss-wdt-sdm845" in sdm845.dtsi - SoC-wide, not
#                        LG-specific; it lives here only for historical reasons
CONFIG_DRM_PANEL_LG_SW49410=y
CONFIG_TOUCHSCREEN_SW49410=y
CONFIG_QCOM_WDT=y
CONFIG_SPI_QCOM_GENI=y

# SOC
# ---------------------------------------------------------------------------
# SoC platform.  Everything below either has a node in sdm845.dtsi / the PMIC
# includes (pm8998.dtsi, pmi8998.dtsi, pm8005.dtsi - the only three PMICs any
# sdm845 board in this tree includes), or is a scheduler/topology tweak.
# ---------------------------------------------------------------------------
# sdm845 is always 4x Kryo385 Silver + 4x Gold = exactly 8 CPUs, so the runtime
# cpumask sizing can be dropped: "Enable CONFIG_FORCE_NR_CPUS, as we always know
# the nr of cpus" [2022-10-24 "fixup: sdm845.config: enable a few options and
# reorganize"].
CONFIG_FORCE_NR_CPUS=y
CONFIG_NR_CPUS=8
# UFS is the only storage on these phones - =y or nothing boots.
CONFIG_SCSI_UFS_QCOM=y
# "qcom,sdm845-llcc" in sdm845.dtsi - the system cache; the GPU and display
# request slices from it.
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_OCMEM=y
# rmtfs reserved-memory node, present in *every* board dtsi here.  The modem
# stores its EFS on the host through it; without it the userspace rmtfs daemon
# has no /dev/qcom_rmtfs_mem* and the modem will not boot.
CONFIG_QCOM_RMTFS_MEM=y
# No DT node - probed from SMEM.  Gives /sys/devices/soc0/*, which is how pmOS
# and users identify the SoC revision from a running system.
CONFIG_QCOM_SOCINFO=y
# Control channel to the WCN3990 WiFi/BT combo ("qcom,wcn3990-bt" in the shift,
# tama, polaris, lg and dipper DTs) - it is what uploads the BT firmware.
CONFIG_QCOM_WCNSS_CTRL=y
# APR is the RPC transport to the ADSP; the whole q6 audio stack in
# sdm845.dtsi (q6afe/q6asm/q6adm) hangs off it.  No APR, no sound at all.
CONFIG_QCOM_APR=y
# "qcom,pm8998-pon" in pm8998.dtsi: power key, resin (volume-down) and, more
# importantly, reboot-mode - the bootloader reads it to enter fastboot/recovery.
CONFIG_POWER_RESET_QCOM_PON=y
# "qcom,spmi-temp-alarm" in pm8998.dtsi - the PMIC's own over-temperature
# shutdown path.
CONFIG_QCOM_SPMI_TEMP_ALARM=y
# "qcom,sdm845-lmh" in sdm845.dtsi - Limits Management Hardware, the in-SoC
# thermal/current throttler for the CPU clusters.  [2021 "arm64: config:
# introduce LMH Kconfig and enable the driver"]
CONFIG_QCOM_LMH=y
# Makes the scheduler aware of the 4+4 big.LITTLE cluster topology (shared L3
# per cluster) - task placement and wake-up balancing on a phone workload.
# [2021-11-20 "sdm845.config: enable config_sched_cluster"]
CONFIG_SCHED_CLUSTER=y
# Voice-call audio path through the ADSP (CS-voice).  Out-of-tree; without it
# you get data but no in-call sound. [2021-06-06 "enable wwan related and
# q6voice configs"]
CONFIG_SND_SOC_QDSP6_Q6VOICE=m
# Raw UFS command passthrough - "enable UFS BSG for slot switching"
# [2022-06-04]: switching the active A/B boot slot from Linux needs it.
CONFIG_SCSI_UFS_BSG=y
# PCIe PHY - only db845c actually has a PCIe slot, but it shares this fragment.
CONFIG_PHY_QCOM_QMP_PCIE=y
# Every panel here registers a backlight (WLED or DSI-private); =y so the
# splash comes up lit. [2021-02-07 "sdm845: build qcom wled and add some pmos
# related configs"]
CONFIG_BACKLIGHT_CLASS_DEVICE=y
# "qcom,sdm845-osm-l3": scales L3/DDR with CPU frequency.  Without it the L3
# stays at its boot rate and the big cores are memory-starved.
# [2023-11-07 "sdm845.config: enable L3 interconnect"]
CONFIG_INTERCONNECT_QCOM_OSM_L3=y
# Notification LED
# Must be builtin as it won't be automatically modprobed
CONFIG_LEDS_TRIGGER_PATTERN=y
# LPG = "qcom,pmi8998-lpg" in pmi8998.dtsi: the RGB notification LED (hence the
# multicolor class) and the pattern trigger userspace drives it with.
CONFIG_LEDS_CLASS_MULTICOLOR=m
CONFIG_LEDS_QCOM_LPG=m
# GENI QUP I2C - the bus every touchscreen, codec, fuel gauge and camera on
# these boards sits on.  =y, everything else would probe-defer behind it.
CONFIG_I2C_QCOM_GENI=y

# Flash LED
# "qcom,pmi8998-flash-led" in pmi8998.dtsi - the camera flash (LEDS_CLASS_FLASH
# further down is its dependency).
CONFIG_LEDS_QCOM_FLASH=m

# Touchscreen - Pocophone F1 / SHIFT6mq
# EDT_FT5X06 covers "focaltech,ft8719" (beryllium-ebbg) and "focaltech,ft5452"
# (shift-axolotl); DW9714 is the "dongwoon,dw9714" lens actuator on axolotl.
CONFIG_TOUCHSCREEN_EDT_FT5X06=m
CONFIG_VIDEO_DW9714=m

# Remoteproc
# WCD9340 audio codec sits on SLIMbus (sdm845-wcd9340.dtsi), hence SLIMBUS +
# the NGD controller (the guest-side controller used when the ADSP owns the
# bus).  REMOTEPROC_CDEV exposes /dev/remoteproc* so userspace can start/stop
# the DSPs.
CONFIG_SLIMBUS=y
CONFIG_SLIM_QCOM_NGD_CTRL=y
CONFIG_REMOTEPROC_CDEV=y

# Battery
# CHARGER_QCOM_SMB2
# ("qcom,pmi8998-charger", upstream v6.5) and QCOM_SPMI_RRADC
# ("qcom,pmi8998-rradc", v6.0) which the charger and fuel gauge read
# current/temperature from. [2021-11-19 "sdm845.config: enable smb2 and rradc"]
CONFIG_CHARGER_QCOM_SMB2=m
CONFIG_QCOM_SPMI_RRADC=m

# Graphics
# DRM + DRM_MSM built in so the display comes up before the rootfs (splash,
# and a black screen otherwise looks like a hang).  FB_SIMPLE keeps the
# bootloader's framebuffer usable until DRM_MSM probes [2021-11-02
# "sdm845.config: switch to simplefb"].  REGULATOR_QCOM_REFGEN
# ("qcom,sdm845-refgen-regulator" in sdm845.dtsi) supplies the QMP/DSI PHYs.
# VIDEO_VIVID is the virtual video device - lets camera userspace be tested on
# a device whose real sensors are not up yet.
CONFIG_DRM=y
CONFIG_FB_SIMPLE=y
CONFIG_DRM_MSM=y
CONFIG_REGULATOR_QCOM_REFGEN=y
# Virtual video test driver
CONFIG_VIDEO_VIVID=m

# Brightness Control
# "qcom,pmi8998-lab-ibb" (panel +/-5V supplies) and "qcom,pmi8998-wled" (LCD
# backlight: beryllium, lg, tama, polaris, perseus).
# [2021-02-07 "sdm845: build qcom wled and add some pmos related configs"]
CONFIG_REGULATOR_QCOM_LABIBB=y
CONFIG_BACKLIGHT_QCOM_WLED=y

# Haptics
# "qcom,pmi8998-haptics" - out-of-tree vibrator driver, ff-memless based.
CONFIG_INPUT_QCOM_PMI8998_HAPTICS=m

# Power management
# Android-style opportunistic suspend: userspace holds /sys/power/wake_lock and
# the kernel suspends whenever no lock is held.  pmOS uses this instead of
# suspend-to-idle races on phones.
CONFIG_PM_AUTOSLEEP=y
CONFIG_PM_WAKELOCKS=y

# MGLRU
# Multi-generational LRU, enabled by default rather than only compiled in -
# these devices have 4-6 GB and swap to zram, which is exactly MGLRU's case.
# [2022-10-26 "fixup: sdm845.config: enable MGLRU by default"]
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y

# libcamera
# libcamera needs large physically-contiguous buffers, handed out through
# /dev/dma_heap/linux,cma.  The 256 MB is measured, not guessed: "The 32MB
# default size is not enough for the front camera in the Pixel 3a, and I assume
# neither is for the cameras in the Pocophone F1" [2024-07-24 "configs: smd845:
# group libcamera requirements and add missing ones", citing
# https://gitlab.com/postmarketOS/pmbootstrap/-/issues/2174#note_1884069175]
CONFIG_DMABUF_HEAPS_CMA=y
CONFIG_DMABUF_HEAPS=y
CONFIG_DMA_CMA=y
CONFIG_CMA=y
CONFIG_CMA_SIZE_MBYTES=256

# Misc useful things
# SCSI_SCAN_ASYNC   overlaps UFS LUN scanning with the rest of boot
# HZ_1000           touch-to-draw latency; a phone is an interactive workload
#                   [2023-05-08 "missing DMABUF bits, HZ_1000"]
CONFIG_SCSI_SCAN_ASYNC=y
CONFIG_HZ_1000=y
# Alpine can't seem to handle this
# ...i.e. modules are shipped zstd-compressed (see MODULE_COMPRESS below) and
# Alpine's modprobe cannot decompress them, so the kernel has to do it itself.
# [2023-06-29 fixup to "sdm845.config: 6.4 additions"]
CONFIG_MODULE_DECOMPRESS=y

# Usage clamping (scale CPU for specific tasks)
# uclamp lets the compositor/foreground app ask for capacity while background
# work is capped - the mainline equivalent of the downstream "boost" knobs.
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y

# Needed for mounting userdata on android
# Android's userdata is ext4 with the quota feature turned on; mounting it
# read-write without quota-v2 support fails.
CONFIG_QFMT_V2=y

# Persistent store
# These phones have no serial console, so ramoops in the reserved memory region
# is the only way to read the log after a hard crash/reboot.  PMSG carries
# userspace's own log.
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# USB
# USB gadget via configfs: this is how pmOS brings up USB networking (and a HID
# gadget) on a phone whose only port is the charging port.
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_HID=y

# VBUS supply out of the pmi8998 charger block - needed for USB host/OTG mode.
# [2022-07 "hacking..." / "sdm845.config: enable vbus regulator"]
CONFIG_REGULATOR_QCOM_USB_VBUS=m

# Notification-LED triggers userspace binds to (oneshot = blink on event,
# backlight = follow the screen, activity = disk/CPU).
CONFIG_LEDS_TRIGGER_ONESHOT=y
CONFIG_LEDS_TRIGGER_BACKLIGHT=y
CONFIG_LEDS_TRIGGER_ACTIVITY=y

# Platform
# EFI stub so the same Image boots from u-boot/EFI on the laptops and db845c.
CONFIG_EFI_GENERIC_STUB=y
# Causes issues with u-boot
# efifb would claim the bootloader framebuffer and then fight simplefb/DRM_MSM
# for it on u-boot boots; the note above is the original report.
CONFIG_FB_EFI=n

# sm8250
# Not sdm845.  This fragment is also used to build for other Qualcomm boards in
# CI, and PHY_QCOM_QMP_USB is the split-out USB-only QMP PHY driver that sm8250
# needs; sdm845 itself uses QMP_COMBO (USB3+DP) and QUSB2.
CONFIG_INTERCONNECT_QCOM_SM8250=y
CONFIG_PHY_QCOM_QMP_USB=y

# Qcom stuff
# ---------------------------------------------------------------------------
# Grab-bag accumulated by the "add sdm845 config fragment" series.  Grouped
# below by what it actually serves.
# ---------------------------------------------------------------------------
# /dev/rpmsg* - userspace access to modem/DSP endpoints (diag, AT, tqftpserv).
CONFIG_RPMSG_CHAR=y
# Note: sdm845.dtsi describes "qcom,sdm845-adsp-pas", which is the *PAS*
# (TrustZone-authenticated) driver, not this one - q6v5_adsp only matches
# "qcom,sdm845-adsp-pil", the non-TZ variant used by some board configs.
# Harmless as a module, but it is not what loads the ADSP on these phones.
CONFIG_QCOM_Q6V5_ADSP=m
# Bluetooth profiles a phone is expected to have: RFCOMM (+TTY) for serial
# profiles, BNEP for tethering, HID battery/hidraw for gamepads and headsets.
# "configs: sdm845: BT_BNEP and BT_RFCOMM must be module" - built-in broke
# loading order in pmOS.
CONFIG_BT_RFCOMM=m
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=m
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_BT_LE=y
CONFIG_HID_BATTERY_STRENGTH=y
CONFIG_HIDRAW=y
# "qcom,pm8998-coincell" in pm8998.dtsi - charges the RTC backup cell, i.e.
# whether the clock survives a battery pull.
CONFIG_QCOM_COINCELL=m
# FastRPC to the compute DSP ("qcom,sdm845-cdsp-pas" + fastrpc nodes in
# sdm845.dtsi) - the offload path camera/ML userspace uses.
CONFIG_QCOM_FASTRPC=m
# PMIC ADCs: VADC handles pm8998's "qcom,spmi-adc-rev2" (thermistors, battery
# ID).  ADC5 is for the newer PMICs (pm6125/pm8150b class) - kept for the
# non-sdm845 boards sharing this fragment.
CONFIG_QCOM_SPMI_VADC=y
CONFIG_QCOM_SPMI_ADC5=y
# The PHYs sdm845.dtsi actually declares: QMP_UFS (storage), QUSB2 (USB2),
# QMP_COMBO (USB3 + DisplayPort alt-mode).  All =y - UFS in particular must be
# available before the rootfs.
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QUSB2=y
CONFIG_PHY_QCOM_QMP_UFS=y
# USB-C port management: "usb-c-connector" nodes (C630, and DP alt-mode on the
# phones).  Made built-in deliberately ["sdm845.config: make typec builtin"].
CONFIG_TYPEC=y
CONFIG_PHY_QCOM_QMP_COMBO=y
CONFIG_LEDS_CLASS_FLASH=y
# Westwood+ as the default congestion control: it estimates available bandwidth
# from ACKs instead of treating every loss as congestion, which is the textbook
# case for wireless links (Kconfig: Westwood+ "significantly increases fairness
# wrt TCP Reno in wired networks and throughput over wireless links").  A phone
# is on WiFi/LTE essentially always.
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_WESTWOOD=y
CONFIG_DEFAULT_WESTWOOD=y
# 8 MB ramdisk - the boot.img initramfs pmOS builds for these devices.
CONFIG_BLK_DEV_RAM=y
CONFIG_BLK_DEV_RAM_SIZE=8192

CONFIG_F2FS_FS=y
# The boot/ESP partition is FAT: UTF-8 as the default NLS, plus NLS_ASCII
# further down - "needed for fat32 boot partitions" [2024-05-19].
# EXFAT for SD cards / shared storage [pmOS community options].
CONFIG_NLS_UTF8=y
CONFIG_NLS_DEFAULT="utf8"
CONFIG_FAT_DEFAULT_UTF8=y
# Available as an option for battery-first setups (schedutil stays default).
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
# SYN flood protection - a phone is directly exposed on mobile networks.
CONFIG_SYN_COOKIES=y
# The pmOS initramfs uses busybox mdev, which is driven by /proc/sys/kernel/
# hotplug - i.e. the uevent helper.  Without it, no device nodes before switch_root.
CONFIG_UEVENT_HELPER=y
# uinput: on-screen keyboards, gesture daemons and Waydroid inject events here.
CONFIG_INPUT_UINPUT=m
# Kernel console over the USB gadget serial port - on a phone with no UART
# this is the only console you get without disassembling it.
CONFIG_U_SERIAL_CONSOLE=y
# Logs every USB enumeration - cheap, and the first thing asked for in a
# "my dock does not work" report.
CONFIG_USB_ANNOUNCE_NEW_DEVICES=y

# Qcomlt
# ---------------------------------------------------------------------------
# Inherited from Linaro's qcom-lt config.  Several entries are for other
# Qualcomm boards (sm6115/qcm2290 = RB1/RB2) rather than sdm845; they are kept
# so one fragment builds for all of them.
# ---------------------------------------------------------------------------
# UFS inline crypto engine: BLK_INLINE_ENCRYPTION + SCSI_UFS_CRYPTO +
# FS_ENCRYPTION(_INLINE_CRYPT) is the chain that lets fscrypt run on the UFS
# hardware instead of the CPU - i.e. Android-style per-file encryption at
# usable speed. [2022-01-27]
CONFIG_BLK_INLINE_ENCRYPTION=y

CONFIG_USB_DWC3_ULPI=y
CONFIG_SCSI_UFS_CRYPTO=y
CONFIG_PHY_QCOM_USB_HS=y
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y
CONFIG_INTERCONNECT_QCOM_SM6115=y
CONFIG_SM_DISPCC_6115=y
CONFIG_FS_ENCRYPTION=y
CONFIG_FS_ENCRYPTION_INLINE_CRYPT=y
CONFIG_CRYPTO_USER_API_AEAD=y
CONFIG_SM_GPUCC_6115=y
# NB: this workaround no longer does anything - "usb: misc: onboard_hub: rename
# to onboard_dev" (v6.10) renamed the symbol to USB_ONBOARD_DEV.  If RB2 still
# breaks, the =n has to move to the new name.
CONFIG_USB_ONBOARD_HUB=n # Breaks USB on rb2
CONFIG_INTERCONNECT_QCOM_QCM2290=y

# qdiscs used by NetworkManager/systemd and by mac80211's multi-queue TX.
CONFIG_NET_SCH_HTB=y
CONFIG_NET_SCH_PRIO=y
CONFIG_NET_SCH_MULTIQ=y

# Debugging stuff
# Symbolic backtraces in oopses - without it, bug reports from users are
# useless.
CONFIG_STACKTRACE=y

#pmOS Related
# ---------------------------------------------------------------------------
# postmarketOS requirements.  Most of this block exists because "pmbootstrap
# kconfig check" fails otherwise; several commits say so outright, e.g.
# "sdm845.config: enable CONFIG_DM_CRYPT - pmOS requires it. kconfig check
# fails without it." [2021-02-15]
#
# DYNAMIC_DEBUG + FTRACE/FUNCTION_TRACER/DYNAMIC_FTRACE: bring-up aids kept on
# deliberately [2024-06-06 "enable dynamic debugging and ftrace"].
# CRYPTO_XTS + BLK_DEV_DM + DM_CRYPT + DM_INTEGRITY: full-disk encryption.
# TMPFS_XATTR + VT: systemd/console basics.
# FW_LOADER_COMPRESS(_ZSTD): linux-firmware ships .zst files [2024-08-03].
# BINFMT_MISC: qemu-user, i.e. running foreign-arch containers on the phone.
# USB_MASS_STORAGE off: the configfs gadget above is the supported path
# [2024-02-11 "pass pmbootstrap kconfig check"].
# ---------------------------------------------------------------------------
CONFIG_DYNAMIC_DEBUG=y
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_VT=y
CONFIG_CRYPTO_XTS=y
CONFIG_TMPFS_XATTR=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y
CONFIG_DM_INTEGRITY=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
CONFIG_BINFMT_MISC=m
CONFIG_NLS_ASCII=y
CONFIG_NULL_TTY=y
# CONFIG_USB_MASS_STORAGE is not set

# USB-C headsets and DACs - the 3.5mm jack is gone on most of these phones.
CONFIG_SND_USB_AUDIO=m

# USB display gadgets/adapters [2021-11-28 "enable wireguard and GUD display
# driver"]; DisplayLink for the laptop docking case.
CONFIG_DRM_GUD=m
CONFIG_DRM_UDL=m # For displaylink usb displays

# pmos containers kconfig
# pmbootstrap's "containers" check group - Docker/podman/k8s on the phone.
# "sdm845.config: pass all pmbootstrap kconfig checks - Everything should work
# now!" [2021-07-10].  cgroup freezer/net_prio, blk throttling, CFS bandwidth,
# thin provisioning, the IPVS + xt_* set for service load balancing, and the
# overlay networking bits (VXLAN, IPVLAN, dummy).
CONFIG_CGROUP_FREEZER=y
CONFIG_NETFILTER_XT_MATCH_IPVS=m
CONFIG_NETFILTER_XT_MARK=m
CONFIG_NETFILTER_XT_MATCH_STATISTIC=m
CONFIG_DUMMY=m
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_NET_CLS_CGROUP=m
CONFIG_IP_VS=m
CONFIG_IP_VS_NFCT=y
CONFIG_IP_VS_PROTO_TCP=y
CONFIG_IP_VS_PROTO_UDP=y
CONFIG_IP_VS_RR=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_DM_THIN_PROVISIONING=y
CONFIG_VXLAN=m
CONFIG_CGROUP_NET_PRIO=y
CONFIG_IPVLAN=m

# pmOS ZRAM kconfig
# zram swap - standard on pmOS, and these devices have 4-6 GB.  zstd chosen as
# the default backend ["ZRAM - Switch to ZSTD compression by default - Enable
# multi-compression streams"], lz4/lzo kept as selectable alternatives, and
# MEMORY_TRACKING/ZSMALLOC_STAT for tuning it. [2022-06 .. 2024-12]
CONFIG_ZSMALLOC=m
CONFIG_ZSMALLOC_STAT=y
CONFIG_ZRAM=m
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZRAM_DEF_COMP="zstd"
CONFIG_ZRAM_MEMORY_TRACKING=y
CONFIG_ZRAM_MULTI_COMP=y
CONFIG_CRYPTO_LZ4=m
CONFIG_LZ4_COMPRESS=m
CONFIG_CRYPTO_LZO=m
CONFIG_CRYPTO_ZSTD=m
CONFIG_ZRAM_BACKEND_ZSTD=y

# module compression
# zstd-compressed modules: smaller /lib/modules on a boot partition that is
# fixed-size and small.  Pairs with MODULE_DECOMPRESS above - the kernel has to
# decompress them itself because Alpine's modprobe does not.
CONFIG_MODULE_COMPRESS=y
CONFIG_MODULE_COMPRESS_ZSTD=y

# pmOS iwd kconfig
# iwd talks to the kernel crypto via AF_ALG, so it needs the USER_API hashes and
# skciphers, DH key operations and KPP (for SAE/WPA3) and MD4 (for legacy
# MSCHAPv2 enterprise networks).  Motivation quoted from the commit: "There are
# some plans to switch wpa_supplicant to iwd in pmOS by default.
# https://gitlab.com/postmarketOS/postmarketos/-/issues/45" [2021-12-02]
CONFIG_CRYPTO_USER_API_HASH=m
CONFIG_CRYPTO_USER_API_SKCIPHER=m
CONFIG_KEY_DH_OPERATIONS=y
CONFIG_CRYPTO_KPP=y
CONFIG_CRYPTO_MD4=m

# PKCS#8 key parsing - needed to load private keys into the kernel keyring
# (802.1X/enterprise WiFi certificates in the iwd case above).
CONFIG_PKCS8_PRIVATE_KEY_PARSER=y

# LEDs
# LED core built in: the LPG/flash drivers and the notification-LED triggers
# above depend on it.
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y


# -- cut here for the production --

# Disable all unrelated stuffs afaik
# =============================================================================
# Deliberately disabled - the "decrease the size of the kernel image" half of
# this fragment's stated purpose.
#
# Hard numbers for this tree (v7.2-rc5): 649 symbols are forced off below, and
# 555 of them are enabled (=y or =m) by arm64 defconfig - so this block is what
# the fragment actually removes, not a wish list.  Spot-checked against every
# sdm845*/sdm850* DT here: none of the disabled drivers matches a compatible
# any of these boards uses.
#
# Built in three passes: [2021-08-15 "cleanup and disable all unrelated configs
# afaik"], [2022-10-23/24 "disable a few more / even more unneeded options" -
# "Disable options, newly introduced with 6.1 - Disable ChromeOS platform
# drivers - Disable Mellanox platform drivers"] and [2023-06-12 "FIXUP:
# sdm845.config: disable a bunch of other qcom stuff"].
#
# Maintenance: a fragment can only switch off symbols it knows about, so this
# needs re-checking whenever defconfig grows.  Entries marked DEAD have been
# renamed or removed upstream and now do nothing at all.
# =============================================================================
# Server/desktop storage and platform bits defconfig turns on: NVMe, ATA/SATA,
# MTD, MD/RAID, SAS HBAs.  Storage on all of these boards is UFS (and SDHCI on
# db845c), so none of it can ever bind.  HIBERNATION: no swap partition, and
# the DSP/modem remoteprocs would not survive a resume.  FW_LOADER_USER_HELPER*:
# the obsolete udev firmware-loading fallback.
CONFIG_ARCH_SPARX5=n
CONFIG_HIBERNATION=n
CONFIG_FW_LOADER_USER_HELPER=n
CONFIG_FW_LOADER_USER_HELPER_FALLBACK=n
CONFIG_BLK_DEV_NVME=n
CONFIG_ATA=n
CONFIG_MTD=n
CONFIG_SRAM=n
CONFIG_MEGARAID_SAS=n
CONFIG_RAID6_PQ_BENCHMARK=n
CONFIG_EEPROM_AT25=n
CONFIG_SCSI_MPT3SAS=n
CONFIG_BLK_DEV_MD=n
CONFIG_DM_MIRROR=n
CONFIG_DM_ZERO=n
CONFIG_EXT2_FS=n
# Other USB controllers, PHYs and Type-C chips.  sdm845 is DWC3 + QUSB2/QMP,
# and USB-C is handled by the PMIC/EC, not by a discrete FUSB302/PTN5150.
CONFIG_USB_DWC2=n
CONFIG_USB_CHIPIDEA=n
CONFIG_USB_MUSB_HDRC=n
CONFIG_USB_ISP1760=n
CONFIG_USB_HSIC_USB3503=n
CONFIG_USB_NET_PLUSB=n
CONFIG_TYPEC_FUSB302=n
CONFIG_EXTCON_PTN5150=n
# Wired NICs, Ethernet PHYs and non-Qualcomm WiFi.  No Ethernet on any board
# here; WiFi is ath10k over SNOC (on-SoC), which is why ATH10K_PCI is off while
# ath10k itself stays on.
CONFIG_REALTEK_PHY=n
CONFIG_NET_VENDOR_NI=n
CONFIG_NET_9P=n
CONFIG_CAN=n
CONFIG_BNX2X=n
CONFIG_MACB=n
CONFIG_IGB=n
CONFIG_IGBVF=n
CONFIG_SMC91X=n
CONFIG_MLX4_EN=n
CONFIG_MLX5_CORE=n
CONFIG_STMMAC_ETH=n
CONFIG_ATL1C=n
CONFIG_BRCMFMAC=n
CONFIG_WL18XX=n
CONFIG_WLCORE=n
CONFIG_ATH10K_PCI=n
CONFIG_ATH11K=n
CONFIG_ATH12K=n
CONFIG_WLAN_VENDOR_INTEL=n
CONFIG_WLAN_VENDOR_MEDIATEK=n
CONFIG_WLAN_VENDOR_RSI=n
# TSN/time-aware shapers and the tc classifier/action set - wired-network and
# industrial features.  The three qdiscs a phone does use (HTB, PRIO, MULTIQ)
